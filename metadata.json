{
  "name": "blockchain_ui",
  "display_name": "Blockchain",
  "version": "0.3.0",
  "type": "ui_qml",
  "category": "blockchain",
  "description": "Blockchain UI module for the Logos application",
  "main": "blockchain_ui_plugin",
  "icon": "src/icons/blockchain.png",
  "view": "qml/BlockchainView.qml",
  "dependencies": ["blockchain_module"],
  "provides": [
    {
      "intent": "node.sign_referral_enrolment",
      "params": [
        { "name": "program", "type": "string", "required": true },
        { "name": "participant_account", "type": "string", "required": true },
        { "name": "referrer", "type": "string", "required": true }
      ]
    },
    {
      "intent": "node.sign_referral_payout",
      "params": [
        { "name": "program_account", "type": "string", "required": true },
        { "name": "blinding_factor", "type": "string", "required": true }
      ]
    },
    {
      "intent": "node.referral_receipt_secret",
      "params": [
        { "name": "purpose", "type": "string", "required": false }
      ]
    }
  ],
  "bootstrap_peers": [],
  "lez_channel_id": "",
  "nix": {
    "packages": {
      "build": ["openssl"],
      "runtime": ["qt6.qtdeclarative", "zstd", "abseil-cpp", "openssl"]
    },
    "external_libraries": [{ "name": "process_stats" }],
    "cmake": {
      "find_packages": ["Qt6Gui", "OpenSSL"],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": ["Qt6::Gui", "OpenSSL::Crypto"]
    }
  }
}
